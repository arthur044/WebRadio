# Normalização padrão: detecta texto e converte para LF no repositório
* text=auto eol=lf

# Scripts que rodam dentro de contêineres Linux precisam de LF mesmo com checkout no Windows
*.sh text eol=lf
*.liq text eol=lf
*.sql text eol=lf
Dockerfile text eol=lf
*.template text eol=lf

# Código-fonte
*.cs text diff=csharp eol=lf
*.csproj text eol=lf
*.sln text eol=crlf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binários: nunca normalizar
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.mp3 binary
*.ogg binary
*.wav binary
*.flac binary
*.dll binary
*.pfx binary
