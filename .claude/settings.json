{
  "permissions": {
    "allow": [
      "Bash(cd *)",
      "Bash(\"$MAESTRI_CLI\" *)",
      "Bash($MAESTRI_CLI *)",
      "Bash(dotnet restore*)",
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(dotnet format*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ci)",
      "Bash(npx tsc*)",
      "Bash(npx vitest*)",
      "Bash(npx playwright test*)",
      "Bash(npx prettier*)",
      "Bash(npx eslint*)",
      "Bash(git status*)",
      "Bash(git fetch*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git worktree list*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr review * --comment*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(git branch)",
      "Bash(git branch --list*)",
      "Bash(git branch -a*)",
      "Bash(git branch -r*)",
      "Bash(git branch --show-current)"
    ],
    "deny": [
      "Bash(git -C * add --all*)",
      "Bash(git -C * add -A*)",
      "Bash(git -C * add . *)",
      "Bash(git -C * add .)",
      "Bash(git -C * clean*)",
      "Bash(git -C * push * -f*)",
      "Bash(git -C * push *+*)",
      "Bash(git -C * push *--force*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git -C * stash*)",
      "Bash(git add --all*)",
      "Bash(git add -A*)",
      "Bash(git add . *)",
      "Bash(git add .)",
      "Bash(git clean*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git stash*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
