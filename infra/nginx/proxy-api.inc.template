# Repasse à API, igual para /api/v1/auth/, /api/ e a rota exata do upload de imagem. Um `location` NÃO herda os proxy_set_header do `server`
# se define algum, então cada um inclui este arquivo. O nome termina em .inc de propósito: o envsubst do nginx-unprivileged o gera em
# /etc/nginx/conf.d/proxy-api.inc (com ${PUBLIC_AUTHORITY} substituído) e o `include conf.d/*.conf` do nginx.conf NÃO o carrega sozinho.
#
# O X-Forwarded-For é SOBRESCRITO com o IP do socket ($remote_addr), nunca anexado ao que o cliente mandou (S-A11): a API só confia
# no cabeçalho vindo do nginx (KnownIPNetworks), e o limite por IP do pedido de música depende disso.
proxy_http_version 1.1;
proxy_set_header Host "${PUBLIC_AUTHORITY}";
proxy_set_header X-Forwarded-Host "${PUBLIC_AUTHORITY}";
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
