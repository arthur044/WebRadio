# Host header injection: com $http_host repassado ao upstream (necessário pra
# assinatura do MinIO manter a porta — ver comentário em /storage/ abaixo), um Host
# forjado chegaria intacto na API/MinIO. Este server captura QUALQUER Host que não
# bata com o server_name explícito do server real logo abaixo e fecha a conexão sem
# resposta (444), antes de tocar em qualquer location/proxy_pass. Precisa ser o
# primeiro server deste arquivo para virar o default_server da porta 8080.
server {
    listen 8080 default_server;
    server_name _;
    return 444;
}

server {
    listen 8080;
    # ${PUBLIC_HOST}: lista dos hosts públicos válidos, espaço-separada (server_name
    # aceita vários). Dev (Dockerfile) já vem com "localhost 127.0.0.1"; o Forge
    # sobrescreve via variável de ambiente do compose em outros ambientes. Segunda
    # camada: o Forge também configura AllowedHosts na API (E1-F06).
    server_name ${PUBLIC_HOST};

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 1m;

    # --- Bloqueios explícitos, ANTES de qualquer proxy (S-A06, S-B05) ---
    # Case-insensitive e tolerante a barra dupla: o roteamento do ASP.NET Core não
    # diferencia maiúsculas, e um bloqueio case-sensitive seria contornável
    # (GET /api/v1/INTERNAL/... passaria). Defesa em profundidade: a API também nunca
    # expõe esse grupo na porta pública (D17), mas o nginx bloqueia de qualquer forma.
    location ~* ^/api/v1/+internal(/|$) {
        include /etc/nginx/security-headers.conf;
        return 404;
    }

    location ~* ^/health(/|$) {
        include /etc/nginx/security-headers.conf;
        return 404;
    }

    # --- SPA ---
    location / {
        include /etc/nginx/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }

    # --- API (mais restrito primeiro: /api/v1/auth/ vence por prefixo mais longo) ---
    location /api/v1/auth/ {
        include /etc/nginx/security-headers.conf;
        limit_req zone=api_auth burst=10 nodelay;
        client_max_body_size 1m;

        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        set $api_upstream http://api:8080;
        proxy_pass $api_upstream;
    }

    location /api/ {
        include /etc/nginx/security-headers.conf;
        limit_req zone=api_geral burst=40 nodelay;
        client_max_body_size 1m;

        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        set $api_upstream http://api:8080;
        proxy_pass $api_upstream;
    }

    # --- SignalR ---
    location /hubs/ {
        include /etc/nginx/security-headers.conf;
        limit_conn conn_hubs 10;
        access_log /dev/stdout hubs_anon;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        set $api_upstream http://api:8080;
        proxy_pass $api_upstream;
    }

    # --- Stream (Icecast) — só GET/HEAD em radio.mp3, resto 404 (S-A07: sem /admin, sem SOURCE) ---
    location = /stream/radio.mp3 {
        include /etc/nginx/security-headers.conf;
        limit_conn conn_stream 5;
        limit_except GET HEAD {
            deny all;
        }
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_set_header Host $http_host;
        # rewrite+break (não "proxy_pass $var/radio.mp3"): com host por variável, um
        # sufixo literal colado no mesmo proxy_pass é ambíguo sobre reescrita de URI —
        # confirmado com um eco na mesma rede (aliases api/icecast/minio) que o Icecast
        # recebe exatamente /radio.mp3, nunca /stream/radio.mp3.
        set $icecast_upstream http://icecast:8000;
        rewrite ^/stream/radio\.mp3$ /radio.mp3 break;
        proxy_pass $icecast_upstream;
    }

    location /stream/ {
        include /etc/nginx/security-headers.conf;
        return 404;
    }

    # --- Storage (MinIO) — porta 9000 nunca publicada; só métodos/caminhos exatos (D18, S-A03, S-A05) ---
    # rewrite + break tira o prefixo /storage/ antes de repassar ao MinIO: o Worker/API
    # assina a POST policy e a URL de GET sem esse prefixo (correção v1.1 do S-A03) —
    # confirmado com eco que o MinIO recebe /midia/x, nunca /storage/midia/x.
    #
    # Host: propositalmente ENCAMINHADO SEM TROCA E COM A PORTA (proxy_set_header Host
    # $http_host — não $host, que descarta a porta — confirmado com eco: Host:
    # site:8080 chegava ao MinIO só como "site" via $host). O mesmo Host que o browser
    # mandou, nunca "minio:9000". A assinatura de uma URL pré-assinada (POST policy ou
    # GET) inclui o Host com a porta; o Storage__PublicEndpoint do backend (E1-F09) é
    # <origem>/storage (com :8080 em dev) e assina contra ESSE host:porta. Se o nginx
    # aqui reescrever ou truncar o Host, toda URL pré-assinada vira 403
    # SignatureDoesNotMatch. Contrato combinado com o Forge: Storage__PublicEndpoint
    # usa exatamente o host:porta que o browser acessa (o $http_host desta borda),
    # nunca o hostname interno do MinIO.
    location ~ ^/storage/quarentena(/|$) {
        include /etc/nginx/security-headers.conf;
        if ($storage_listing_blocked) {
            return 404;
        }
        limit_except POST {
            deny all;
        }
        client_max_body_size 250m;
        # $minio_upstream ANTES do rewrite: "break" para o módulo rewrite ali mesmo,
        # então um "set" escrito depois de "break" nunca roda (fica vazio → 500).
        set $minio_upstream http://minio:9000;
        rewrite ^/storage/(.*)$ /$1 break;
        proxy_set_header Host $http_host;
        proxy_pass $minio_upstream;
    }

    location ~ ^/storage/midia/ {
        include /etc/nginx/security-headers.conf;
        if ($storage_listing_blocked) {
            return 404;
        }
        limit_except GET HEAD {
            deny all;
        }
        set $minio_upstream http://minio:9000;
        rewrite ^/storage/(.*)$ /$1 break;
        proxy_set_header Host $http_host;
        proxy_pass $minio_upstream;
    }

    # Raiz exata do bucket (sem chave) → 404 ANTES do proxy: listagem do bucket
    # público vaza divulgações ainda não publicadas (S-A05). Camada extra além da
    # política do MinIO (que já nega s3:ListBucket).
    location = /storage/publico/ {
        include /etc/nginx/security-headers.conf;
        return 404;
    }

    location ~ ^/storage/publico/ {
        include /etc/nginx/security-headers.conf;
        # Conteúdo enviado por usuários (imagens de divulgação): nosniff já vem do
        # include acima; CSP sandbox soma (não substitui) mais uma camada contra um
        # upload que escape da recodificação da API (S-A05).
        add_header Content-Security-Policy "sandbox" always;
        if ($storage_listing_blocked) {
            return 404;
        }
        limit_except GET HEAD {
            deny all;
        }
        set $minio_upstream http://minio:9000;
        rewrite ^/storage/(.*)$ /$1 break;
        proxy_set_header Host $http_host;
        proxy_pass $minio_upstream;
    }

    location /storage/ {
        include /etc/nginx/security-headers.conf;
        return 404;
    }
}
