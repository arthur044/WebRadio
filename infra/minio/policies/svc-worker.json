{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApagarImagensDeDivulgacao",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::publico/divulgacoes/*"
      ]
    },
    {
      "Sid": "ListarImagensDeDivulgacao",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::publico"
      ],
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "divulgacoes/"
          ]
        }
      }
    }
  ]
}
