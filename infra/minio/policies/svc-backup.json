{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LerMidiaEPublicoParaOBackup",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::midia/*",
        "arn:aws:s3:::publico/*"
      ]
    },
    {
      "Sid": "ListarMidiaEPublicoParaOBackup",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::midia",
        "arn:aws:s3:::publico"
      ]
    }
  ]
}
