{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssinarUploadDaQuarentena",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::quarentena/*"
      ]
    },
    {
      "Sid": "HeadDoConcluirNaQuarentena",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::quarentena/*"
      ]
    },
    {
      "Sid": "PreviewDaMidia",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::midia/*"
      ]
    },
    {
      "Sid": "ImagensDeDivulgacao",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::publico/divulgacoes/*"
      ]
    },
    {
      "Sid": "HeadBucketExigidoPeloSdk",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::quarentena",
        "arn:aws:s3:::midia",
        "arn:aws:s3:::publico"
      ]
    }
  ]
}
