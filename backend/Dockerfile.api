# syntax=docker/dockerfile:1
# E1-F13 — imagem do Api. Contexto de build = RAIZ do repositório:
#   docker build -f backend/Dockerfile.api -t webradio-api .
# Imagens fixadas por digest (sdk/aspnet 10.0-alpine); atualizar via Dependabot/PR.

FROM mcr.microsoft.com/dotnet/sdk:10.0.403-alpine3.24@sha256:5562fd626eec39f6f53218f9b7d7856ab7195d51d846568304fbe85071a3b6e6 AS build
WORKDIR /src
COPY backend/ backend/
RUN dotnet publish backend/src/WebRadio.Api/WebRadio.Api.csproj -c Release -o /out --no-self-contained -r linux-musl-x64 \
    -p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0.14-alpine3.24@sha256:254fe017495996d3abcc487ffacdcce2b73affb380d3af87af12c8dff41fe0b0
# InvariantGlobalization está DESLIGADO de propósito (Microsoft.Data.SqlClient quebra, ver Directory.Build.props):
# a imagem Alpine vem com a variável ligada e sem ICU.
RUN apk add --no-cache icu-libs
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    ASPNETCORE_ENVIRONMENT=Production
WORKDIR /app
COPY --from=build /out .
USER app
ENTRYPOINT ["dotnet", "WebRadio.Api.dll"]
