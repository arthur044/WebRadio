# syntax=docker/dockerfile:1
# E1-F13 — imagem do Api. Contexto de build = RAIZ do repositório:
#   docker build -f backend/Dockerfile.api -t webradio-api .
# Imagens fixadas por digest (sdk/aspnet 10.0-alpine); atualizar via Dependabot/PR.

FROM mcr.microsoft.com/dotnet/sdk:10.0.402-alpine3.24@sha256:496914451b05ac5a24592024362ec370c3a2d3c3fe817f864e4aa55c4c194a56 AS build
WORKDIR /src
COPY backend/ backend/
RUN dotnet publish backend/src/WebRadio.Api/WebRadio.Api.csproj -c Release -o /out --no-self-contained \
    -p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0.13-alpine3.24@sha256:ecf8dcbaab8ebc4bdfb2322d6fe4217bbb118894310ebb6d53c580874ab4b27d
# InvariantGlobalization está DESLIGADO de propósito (Microsoft.Data.SqlClient quebra, ver Directory.Build.props):
# a imagem Alpine vem com a variável ligada e sem ICU.
RUN apk add --no-cache icu-libs
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    ASPNETCORE_ENVIRONMENT=Production
WORKDIR /app
COPY --from=build /out .
USER app
ENTRYPOINT ["dotnet", "WebRadio.Api.dll"]
