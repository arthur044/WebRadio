# syntax=docker/dockerfile:1
# E1-F13 — imagem do Worker. Contexto de build = RAIZ do repositório:
#   docker build -f backend/Dockerfile.worker -t webradio-worker .
# Imagens fixadas por digest (sdk/runtime 10.0-alpine); atualizar via Dependabot/PR.

FROM mcr.microsoft.com/dotnet/sdk:10.0.403-alpine3.24@sha256:cc02b814237a76c4735fb6eeee87181597b5e56f2ce458a435e527674d91f4d7 AS build
WORKDIR /src
COPY backend/ backend/
RUN dotnet publish backend/src/WebRadio.Worker/WebRadio.Worker.csproj -c Release -o /out --no-self-contained -r linux-musl-x64 \
    -p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:10.0.13-alpine3.24@sha256:6a97a629f6c44e7263b41175e79cb9aeb1df631d3714e74e80a4ddd016258646
# InvariantGlobalization está DESLIGADO de propósito (Microsoft.Data.SqlClient quebra, ver Directory.Build.props):
# a imagem Alpine vem com a variável ligada e sem ICU.
RUN apk add --no-cache icu-libs
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
WORKDIR /app
COPY --from=build /out .
USER app
ENTRYPOINT ["dotnet", "WebRadio.Worker.dll"]
