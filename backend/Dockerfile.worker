# syntax=docker/dockerfile:1
# E1-F13 — imagem do Worker. Contexto de build = RAIZ do repositório:
#   docker build -f backend/Dockerfile.worker -t webradio-worker .
# Imagens fixadas por digest (sdk/runtime 10.0-alpine); atualizar via Dependabot/PR.

FROM mcr.microsoft.com/dotnet/sdk:10.0.404-alpine3.24@sha256:0294f285d062afacc8b5f6d7febb0cd4ee879320e5585fa15f2f4ebf1feb9ba7 AS build
WORKDIR /src
COPY backend/ backend/
RUN dotnet publish backend/src/WebRadio.Worker/WebRadio.Worker.csproj -c Release -o /out --no-self-contained -r linux-musl-x64 \
    -p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:10.0.15-alpine3.24@sha256:7518aaad9e4328001518006a7e8b3fcf6ce8f8816355574f7264c1fa0a0ce188
# InvariantGlobalization está DESLIGADO de propósito (Microsoft.Data.SqlClient quebra, ver Directory.Build.props):
# a imagem Alpine vem com a variável ligada e sem ICU.
RUN apk add --no-cache icu-libs
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
WORKDIR /app
COPY --from=build /out .
# E4-D1: o Worker e o sanitizer dividem o tmpfs /jobs (uid 65532, modo 0700); o Worker roda com o MESMO uid (era o `app`, 1654).
USER 65532:65532
ENTRYPOINT ["dotnet", "WebRadio.Worker.dll"]
