<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    ATENCAO LICENCA (aviso do Nexus, 2026-09-27): MediatR passou a licenca comercial
    a partir da v13. Fixado em 12.4.1 (Apache-2.0) deliberadamente. NAO atualizar
    para 13.x sem decisao explicita do Planejador sobre custo de licenca.
  -->
  <ItemGroup>
    <PackageVersion Include="MediatR" Version="12.4.1" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
  </ItemGroup>

  <!-- Api (E1-F06) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <!-- SignalR (E1-F10): backplane Redis na Api; cliente só nos testes -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
  </ItemGroup>

  <!-- Teste de arquitetura (E1-F02) -->
  <ItemGroup>
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

  <!-- Worker (E1-F11): host generico fora do ciclo de vida da Api -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <!-- Segredos por arquivo no Worker (a Api recebe o mesmo pacote pelo shared framework do ASP.NET) -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.KeyPerFile" Version="10.0.13" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.5" />
    <PackageVersion Include="Minio" Version="7.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <!-- Infrastructure/EF (E1-F04). IRadioDbContext (Application) usa DbSet&lt;T&gt; da mesma versão. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <!--
      NuGetAudit (NU1903): System.Security.Cryptography.Xml 9.0.0 chega transitivo via
      Microsoft.EntityFrameworkCore.Design e tem varias CVEs de severidade alta (GHSA-23rf-6693-g89p
      e outras). Pin explicito de CPM sobrescreve a versao transitiva vulneravel.
    -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <!--
      Vulnerabilidades (B3): System.Security.Cryptography.Pkcs 9.0.4 chega transitivo via Microsoft.Data.SqlClient 6.1.1
      (GHSA-846f-f764-76mx, alta; GHSA-2fmv-rv2c-59x7, moderada; corrigidas em 10.0.13). Mesmo recurso do pin acima.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Auth (E1-F07) -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.13" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
  </ItemGroup>

  <!-- Infraestrutura de testes -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
  </ItemGroup>

</Project>
