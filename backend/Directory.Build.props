<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!--
      E1-F04: InvariantGlobalization=true quebra Microsoft.Data.SqlClient por completo
      (System.NotSupportedException ao abrir a conexão — "Globalization Invariant Mode is not
      supported", reproduzido com `dotnet ef database update` contra SQL Server real). Como Api,
      Worker e Migrator dependem de EF Core/SqlClient em runtime, manter isso ligado quebraria o
      stack inteiro. Desligado deliberadamente; nunca reative sem trocar de driver de SQL Server.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <!--
      F17b (05 §9.5): auditoria de vulnerabilidades do NuGet explícita, também nas dependências transitivas. Com
      TreatWarningsAsErrors, o nível padrão (low) quebraria o build por um NU1901 de baixa gravidade; de "moderate" para cima
      (NU1902–NU1904) quebra, de propósito. O job `vulnerabilidades` do CI (trivy, npm audit) é outra tarefa (F17).
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
  </PropertyGroup>

  <!-- Projetos de teste relaxam algumas regras que atrapalham fixtures/mocks -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) Or $(MSBuildProjectName.EndsWith('.IntegrationTests'))">
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707;CA2007</NoWarn>
  </PropertyGroup>

</Project>
