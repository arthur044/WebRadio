# syntax=docker/dockerfile:1
# E1-F13/F05 — migrator: efbundle self-contained (linux-musl-x64) + infra/migrator/entrypoint.sh.
# Contexto de build = RAIZ do repositório:  docker build -f backend/Dockerfile.migrator -t webradio-migrator .

FROM mcr.microsoft.com/dotnet/sdk:10.0.402-alpine3.24@sha256:496914451b05ac5a24592024362ec370c3a2d3c3fe817f864e4aa55c4c194a56 AS build
WORKDIR /src
# Versão do dotnet-ef = a do EF Core em Directory.Packages.props.
RUN dotnet tool install dotnet-ef --version 10.0.13 --tool-path /tools
COPY backend/ backend/
RUN dotnet restore backend/src/WebRadio.Infrastructure -r linux-musl-x64 && \
    /tools/dotnet-ef migrations bundle --project backend/src/WebRadio.Infrastructure \
    --self-contained -r linux-musl-x64 --force -o /out/efbundle

FROM mcr.microsoft.com/dotnet/runtime:10.0.14-alpine3.24@sha256:54d48f739ebffdef82388056d420af37ed39c722b8d5ee5dedca6878537c2737
RUN apk add --no-cache bash icu-libs
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
# O efbundle extrai libmsalruntime.so (Microsoft.Identity.Client.NativeInterop, transitivo de Microsoft.Data.SqlClient 6.1.7)
# ao iniciar; o padrão é $HOME/.net, que não é gravável com read_only (exit 159, "Default extraction directory [/home/app]").
# /tmp é gravável também no compose (tmpfs). A lib só é extraída, nunca carregada: o noexec do tmpfs não atrapalha.
ENV DOTNET_BUNDLE_EXTRACT_BASE_DIR=/tmp
WORKDIR /app
COPY --from=build /out/efbundle ./efbundle
COPY --chmod=0555 infra/migrator/entrypoint.sh ./entrypoint.sh
USER app
ENTRYPOINT ["./entrypoint.sh"]
